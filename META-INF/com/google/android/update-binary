#!/system/bin/sh
#################
# Initialization
#################

umask 022

# echo before loading util_functions
ui_print() { echo "$@"; }

require_new_magisk() {
    ui_print "*******************************"
    ui_print " Please install Magisk v20.4+! "
    ui_print "*******************************"
    exit 1
}

#########################
# Load util_functions.sh
#########################

OUTFD=/proc/self/fd/$1
ZIPFILE=$2
ZIPPATH=$3
SHAMAGIC=$4
BUSYBOX=/data/adb/magisk/busybox

[ -f $BUSYBOX ] || require_new_magisk
$BUSYBOX sh -c 'export ASH_STANDALONE=1; . /data/adb/magisk/.util_functions.sh' -- $OUTFD $ZIPFILE $ZIPPATH $SHAMAGIC || require_new_magisk